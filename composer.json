{
  "name": "wp-slimstat/wp-slimstat",
  "description": "The leading web analytics plugin for WordPress",
  "homepage": "https://wp-slimstat.com/",
  "license": "MIT",
  "config": {
    "platform-check": false
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/veronalabs-browscap-php",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "SlimStat\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WpSlimstat\\Tests\\": "tests/"
    }
  },
  "require": {
    "veronalabs/browscap-php": "dev-standalone"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6",
    "phpstan/phpstan": "^2.2",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "extra": {
    "mozart": {
      "dep_namespace": "SlimStat\\Dependencies\\",
      "dep_directory": "/src/Dependencies/",
      "classmap_directory": "/src/",
      "classmap_prefix": "SlimStat_",
      "packages": [
        "veronalabs/browscap-php",
        "league/flysystem"
      ],
      "delete_vendor_directories": true
    }
  },
  "scripts": {
    "post-install-cmd": [
      "~/.composer/vendor/bin/mozart compose",
      "composer dump-autoload"
    ],
    "post-update-cmd": [
      "~/.composer/vendor/bin/mozart compose",
      "composer dump-autoload"
    ],
    "build:autoload": "composer dump-autoload --no-dev --classmap-authoritative",
    "i18n:pot": "wp i18n make-pot . languages/wp-slimstat.pot --domain=wp-slimstat --skip-plugins --skip-themes",
    "i18n:json": "wp i18n make-json languages/ --no-purge --pretty-print",
    "i18n": [
      "@i18n:pot",
      "@i18n:json"
    ],
    "test:license-tags": "php tests/license-tag-gating-test.php",
    "test:license-enforcement": "php tests/license-enforcement-test.php",
    "test:license-validator": "php tests/license-validator-test.php",
    "test:goals-tier-restore": "php tests/goals-tier-restore-test.php",
    "test:geoip-resolver": "php tests/resolve-geolocation-provider-test.php",
    "test:geoservice": "php tests/geoservice-provider-resolution-test.php",
    "test:cf-country-validation": "php tests/cloudflare-geolocation-country-validation-test.php",
    "test:legacy-sync": "php tests/legacy-sync-mapping-test.php",
    "test:lazy-migration": "php tests/lazy-migration-test.php",
    "test:content-type-attachment": "php tests/content-type-attachment-test.php",
    "test:rest-controller": "php tests/tracking-rest-controller-test.php",
    "test:reports-escaping": "php tests/reports-output-escaping-test.php",
    "test:fingerprint-sanitize": "php tests/fingerprint-sanitization-test.php",
    "test:gdpr-consent": "php tests/gdpr-consent-cookie-test.php",
    "test:user-exclusion": "php tests/user-exclusion-processor-test.php",
    "test:ajax-resource-fix": "php tests/ajax-resource-fix-test.php",
    "test:js-banner-gdpr": "php tests/js-params-banner-gdpr-consistency-test.php",
    "test:v5460-migration": "php tests/v5460-settings-migration-test.php",
    "test:early-translation": "php tests/early-translation-test.php",
    "test:tracker-health-auth": "php tests/tracker-health-auth-test.php",
    "test:browscap-isolation": "php tests/browscap-settings-isolation-test.php",
    "test:browscap-filesystem": "php tests/browscap-wp-filesystem-test.php",
    "test:dnt-gdpr": "php tests/dnt-gdpr-independence-test.php",
    "test:browscap-bot-safety": "php tests/browscap-bot-safety-net-test.php",
    "test:storage-update-sanitize": "php tests/storage-update-sanitization-test.php",
    "test:referer-android-app": "php tests/referer-android-app-storage-test.php",
    "test:referer-searchterms-encoding": "php tests/referer-searchterms-encoding-test.php",
    "test:php74-compat": "php tests/php74-no-php80-functions-test.php",
    "test:implicit-nullable": "php tests/php-implicit-nullable-test.php",
    "test:ci-matrix-coverage": "php tests/ci-matrix-coverage-test.php",
    "test:dtr-pton-init": "php tests/dtr-pton-init-test.php",
    "test:loose-comparison-scan": "php tests/loose-comparison-scan-test.php",
    "test:wp-version-guard": "php tests/wp70-wp-version-guard-test.php",
    "test:php80-syntax": "php tests/php80-syntax-scan-test.php",
    "test:php-forward": "php tests/php82-84-forward-scan-test.php",
    "test:wp-removed-core-fns": "php tests/wp-removed-core-fns-scan-test.php",
    "test:wp70-tested-up-to": "php tests/wp70-tested-up-to-test.php",
    "test:dead-symfony-removed": "php tests/dead-symfony-removed-test.php",
    "test:jquery4-shorthand": "php tests/jquery4-own-code-shorthand-scan-test.php",
    "test:loginnote-bracket-parse": "php tests/loginnote-bracket-parse-test.php",
    "test:shortcode-w-whitelist": "php tests/shortcode-w-whitelist-test.php",
    "test:avg-duration-format": "php tests/avg-duration-format-test.php",
    "test:admin-ui-render-guards": "php tests/admin-ui-render-guards-test.php",
    "test:goals-free-limit": "php tests/goals-free-active-limit-test.php",
    "test:goals-indexes-migration": "php tests/goals-funnels-index-migration-test.php",
    "test:access-log-author-link": "php tests/access-log-author-edit-link-test.php",
    "test:funnels-widget-compact": "php tests/funnels-widget-compact-test.php",
    "test:css-selector-scope": "php tests/css-selector-scope-test.php",
    "phpstan": "phpstan analyse --memory-limit=2G",
    "test:phpstan": "@phpstan",
    "test:source-level": [
      "@test:php74-compat",
      "@test:implicit-nullable",
      "@test:ci-matrix-coverage",
      "@test:dtr-pton-init",
      "@test:loose-comparison-scan",
      "@test:wp-version-guard",
      "@test:php80-syntax",
      "@test:php-forward",
      "@test:wp-removed-core-fns",
      "@test:wp70-tested-up-to",
      "@test:dead-symfony-removed",
      "@test:jquery4-shorthand",
      "@test:loginnote-bracket-parse",
      "@test:shortcode-w-whitelist",
      "@test:avg-duration-format",
      "@test:admin-ui-render-guards",
      "@test:goals-free-limit",
      "@test:goals-indexes-migration",
      "@test:access-log-author-link",
      "@test:funnels-widget-compact",
      "@test:css-selector-scope"
    ],
    "test:unit": "phpunit --configuration phpunit.xml.dist --testsuite=Unit",
    "test:integration": "phpunit --configuration phpunit.xml.dist --testsuite=Integration --bootstrap tests/bootstrap-integration.php",
    "test:all": [
      "@test:unit",
      "@test:integration",
      "@test:source-level",
      "@test:license-tags",
      "@test:license-enforcement",
      "@test:license-validator",
      "@test:goals-tier-restore",
      "@test:geoip-resolver",
      "@test:geoservice",
      "@test:cf-country-validation",
      "@test:legacy-sync",
      "@test:lazy-migration",
      "@test:content-type-attachment",
      "@test:rest-controller",
      "@test:reports-escaping",
      "@test:fingerprint-sanitize",
      "@test:gdpr-consent",
      "@test:user-exclusion",
      "@test:ajax-resource-fix",
      "@test:js-banner-gdpr",
      "@test:v5460-migration",
      "@test:early-translation",
      "@test:tracker-health-auth",
      "@test:browscap-isolation",
      "@test:browscap-filesystem",
      "@test:dnt-gdpr",
      "@test:browscap-bot-safety",
      "@test:storage-update-sanitize",
      "@test:referer-android-app",
      "@test:referer-searchterms-encoding"
    ]
  }
}
