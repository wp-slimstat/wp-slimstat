{
  "name": "wp-slimstat/wp-slimstat",
  "description": "The leading web analytics plugin for WordPress",
  "homepage": "https://wp-slimstat.com/",
  "license": "MIT",
  "config": {
    "platform-check": false,
    "autoloader-suffix": "218de6ada5bccdc9e632ba1181c21f7e"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/veronalabs-browscap-php",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "SlimStat\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WpSlimstat\\Tests\\": "tests/"
    }
  },
  "require": {
    "veronalabs/browscap-php": "dev-standalone"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6",
    "phpstan/phpstan": "^2.2",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "extra": {
    "mozart": {
      "dep_namespace": "SlimStat\\Dependencies\\",
      "dep_directory": "/src/Dependencies/",
      "classmap_directory": "/src/",
      "classmap_prefix": "SlimStat_",
      "packages": [
        "veronalabs/browscap-php",
        "league/flysystem"
      ],
      "delete_vendor_directories": true
    }
  },
  "scripts": {
    "post-install-cmd": [
      "~/.composer/vendor/bin/mozart compose",
      "composer dump-autoload"
    ],
    "post-update-cmd": [
      "~/.composer/vendor/bin/mozart compose",
      "composer dump-autoload"
    ],
    "build:autoload": "composer dump-autoload --no-dev -o",
    "i18n:pot": "wp i18n make-pot . languages/wp-slimstat.pot --domain=wp-slimstat --skip-plugins --skip-themes",
    "i18n:json": "wp i18n make-json languages/ --no-purge --pretty-print",
    "i18n": [
      "@i18n:pot",
      "@i18n:json"
    ],
