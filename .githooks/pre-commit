#!/usr/bin/env bash
#
# Plugin pre-commit gate — BYTE-IDENTICAL in wp-slimstat and wp-slimstat-pro, and
# jaan-to/bin/check-twins.sh holds them so (the label below is derived, not typed).
#
# Two gates:
#   1. `php -l` on every staged PHP file. Fast, dependency-free.
#   2. `composer test:source-level` whenever anything a source-level gate reads is staged —
#      PHP, composer.json, workflows, mutations, .distignore, readme.txt. Until 2026-09-04 both
#      hooks ran gate 1 only, so a commit that broke any of the ~140 source-level gates, or a
#      mutation, landed locally with no resistance and surfaced on CI after push (DoD 19).
#
# A gate that cannot run must FAIL, not skip: composer missing from PATH is an error here,
# because a gate that silently does not run is this workspace's most repeated defect.
# /simplify is enforced by the Claude Code commit gate, not here (a shell hook cannot call it).
#
set -euo pipefail

repo="$(basename "$(git rev-parse --show-toplevel)")"
echo "→ running fast gate before commit (${repo})"

staged="$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n')"
staged_php="$(printf '%s\n' "$staged" | grep -E '\.php$' || true)"

if [ -n "$staged_php" ]; then
  fail=0
  while IFS= read -r file; do
    [ -z "$file" ] && continue
    if ! php -l "$file" > /dev/null 2>&1; then
      echo "  ✗ syntax error in $file"
      php -l "$file" || true
      fail=1
    fi
  done <<< "$staged_php"
  if [ "$fail" -ne 0 ]; then
    echo "  gate failed — commit rejected"
    exit 1
  fi
  echo "  ✓ all staged PHP files pass php -l"
fi

# Anything a source-level gate reads. Docs and assets alone do not trigger the ~60 s suite.
gate_inputs="$(printf '%s\n' "$staged" | grep -E '\.php$|(^|/)composer\.json$|^\.github/|^tests/mutations/|^\.distignore$|^readme\.txt$|\.ya?ml$' || true)"

if [ -z "$gate_inputs" ]; then
  echo "  no source-level inputs staged, suite skipped"
  exit 0
fi

if ! command -v composer > /dev/null 2>&1; then
  echo "  ✗ composer is not on PATH, so composer test:source-level cannot run."
  echo "    This gate does not skip: install composer, or commit with --no-verify and say why."
  exit 1
fi

echo "  running composer test:source-level (staged: $(printf '%s\n' "$gate_inputs" | wc -l | tr -d ' ') gate input(s))"
log="$(mktemp)"
if composer test:source-level > "$log" 2>&1; then
  echo "  ✓ source-level suite green"
  rm -f "$log"
  exit 0
fi

echo "  ✗ source-level suite failed — commit rejected. Last lines:"
tail -n 25 "$log" | sed 's/^/    /'
echo "    full log: $log"
exit 1
