#: admin/config/index.php:658
msgid "REST API"
msgstr ""

#: admin/config/index.php:662
msgid "Tokens"
msgstr ""

#: admin/config/index.php:664
msgid "Configure a strong random token to enable report API access. Send it in the Authorization: Bearer TOKEN header over HTTPS. Treat tokens as passwords: they grant access to visitor reports. Leaving this field empty disables token access. Query-string tokens remain supported for existing integrations, but can be exposed in server logs and should be replaced with headers."
msgstr ""

#: admin/config/index.php:670
msgid "Maintenance"
msgstr ""

#: admin/config/index.php:674
msgid "Data retention and auto-purge"
msgstr ""

#: admin/config/index.php:678
msgid "Retention period"
msgstr ""

#: admin/config/index.php:681
msgid "Age in days at which live analytics is deleted or archived, according to Archive mode. Set 0 to disable live-data cleanup. Choose a retention period appropriate for your site. Archived records have a separate lifetime and still count as retained data."
msgstr ""

#: admin/config/index.php:684
msgid "Archive mode"
msgstr ""

#: admin/config/index.php:686
msgid "On archives expired live pageviews and events. Off permanently deletes them. Archived records remain stored until their separate archive retention period expires."
msgstr ""

#: admin/config/index.php:690
msgid "Automatic table optimization"
msgstr ""

#: admin/config/index.php:692
msgid "Disabled by default. Deleted rows leave space that the database can reuse. Enable only with your hosting provider's agreement: rebuilding live tables may reclaim disk space but can delay tracking while locks are held. Runs at most once every 30 days after removing pageviews; archive tables are never optimized."
msgstr ""

#: admin/config/index.php:695
msgid "Archive retention (days)"
msgstr ""

#: admin/config/index.php:697
msgid "Permanently delete archived pageviews and events older than this many days, measured from the original visit. Set 0 to keep archives indefinitely. Existing archives are preserved until you choose a period. Back up data you need before enabling expiration."
msgstr ""

