#: admin/config/index.php:332
msgid "Geolocation precision"
msgstr ""

#: admin/config/index.php:334 admin/index.php:2558
#: src/Services/Privacy/DataExporter.php:135
msgid "Country"
msgstr "国家"

#: admin/config/index.php:335 admin/view/wp-slimstat-db.php:87
#: src/Services/Privacy/DataExporter.php:142
