{
  "schema": "SLIMSTAT-ORACLE-CONTRACTS-V1",
  "reports": {
    "chart_daily": {
      "report_id": "slim_p1_01",
      "title": "Pageviews",
      "family": "chart",
      "metric_column": "ip",
      "duration_days": 5,
      "granularity": "DAY",
      "start_of_week": 1,
      "timezone": "UTC"
    },
    "chart_weekly": {
      "report_id": "slim_p1_01",
      "title": "Pageviews",
      "family": "chart",
      "metric_column": "ip",
      "duration_days": 60,
      "granularity": "WEEK",
      "start_of_week": 1,
      "timezone": "UTC"
    },
    "get_recent": {
      "report_id": "slim_p7_02",
      "title": "Access Log",
      "family": "recent",
      "limit_setting": "limit_results",
      "default_limit": 200,
      "columns": [
        "id", "ip", "dt", "username", "referer", "resource", "browser", "platform",
        "country", "city", "content_type", "notes", "visit_id", "server_latency",
        "page_performance", "browser_version", "browser_type", "language", "fingerprint",
        "user_agent", "resolution", "screen_width", "screen_height", "category", "author",
        "content_id", "outbound_resource", "tz_offset", "dt_out"
      ]
    },
    "count_records_id": {
      "report_id": "slim_p1_03",
      "title": "At a Glance",
      "family": "count",
      "column": "id",
      "distinct": false,
      "equality": "binary",
      "windowed": false
    },
    "count_records_ip": {
      "report_id": "slim_p1_03",
      "title": "At a Glance",
      "family": "count",
      "column": "ip",
      "distinct": true,
      "equality": "ascii_ci",
      "windowed": false
    },
    "count_records_resource": {
      "report_id": "slim_p1_03",
      "title": "At a Glance",
      "family": "count",
      "column": "resource",
      "distinct": true,
      "equality": "ascii_ci",
      "windowed": false
    },
    "rows_in_window": {
      "report_id": "slim_p1_03",
      "title": "At a Glance",
      "family": "count",
      "column": "id",
      "distinct": false,
      "equality": "binary",
      "windowed": true
    },
    "top_resource": {
      "report_id": "slim_p1_08",
      "title": "Top Web Pages",
      "family": "top",
      "dimension": "resource",
      "grain": ["blog_id"],
      "count_field": "counthits",
      "limit_setting": "limit_results",
      "default_limit": 200
    },
    "top_country": {
      "report_id": "slim_p1_13",
      "title": "Top Countries",
      "family": "top",
      "dimension": "country",
      "grain": ["blog_id"],
      "count_field": "counthits",
      "limit_setting": "limit_results",
      "default_limit": 200
    },
    "top_platform": {
      "report_id": "slim_p2_06",
      "title": "Top Operating Systems",
      "family": "top",
      "dimension": "platform",
      "grain": ["blog_id"],
      "count_field": "counthits",
      "limit_setting": "limit_results",
      "default_limit": 200
    }
  }
}
