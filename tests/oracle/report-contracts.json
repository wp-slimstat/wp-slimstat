  "reports": {
    "chart_daily": {
      "report_id": "slim_p1_01",
      "title": "Pageviews",
      "family": "chart",
      "metric_column": "ip",
      "duration_days": 5,
      "granularity": "DAY",
      "start_of_week": 1,
      "timezone": "UTC"
    },
    "chart_weekly": {
      "report_id": "slim_p1_01",
      "title": "Pageviews",
      "family": "chart",
      "metric_column": "ip",
