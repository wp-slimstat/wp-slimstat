      "report_id": "slim_p4_23",
      "title": "Top Bounce Pages",
      "family": "count",
      "kind": "singletons",
      "group_column": "resource",
      "counted_column": "visit_id",
      "where": [["visit_id", "gt", 0], ["content_type", "ne", "404"]],
      "equality": "ascii_ci",
      "windowed": true
    },
