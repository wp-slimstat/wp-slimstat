{
  "schema": "SLIMSTAT-ORACLE-CONTRACTS-V1",
  "reports": {
    "chart_daily": {
      "report_id": "slim_p1_01",
      "title": "Pageviews",
      "family": "chart",
      "metric_column": "ip",
      "duration_days": 5,
      "granularity": "DAY",
      "start_of_week": 1,
      "timezone": "UTC"
    },
    "chart_weekly": {
      "report_id": "slim_p1_01",
      "title": "Pageviews",
      "family": "chart",
      "metric_column": "ip",
      "duration_days": 60,
      "granularity": "WEEK",
      "start_of_week": 1,
      "timezone": "UTC"
    },
    "get_recent": {
      "report_id": "slim_p7_02",
      "title": "Access Log",
      "family": "recent",
      "limit_setting": "limit_results",
      "default_limit": 200,
      "columns": [
        "id", "ip", "dt", "username", "referer", "resource", "browser", "platform",
        "country", "city", "content_type", "notes", "visit_id", "server_latency",
        "page_performance", "browser_version", "browser_type", "language", "fingerprint",
        "user_agent", "resolution", "screen_width", "screen_height", "category", "author",
        "content_id", "outbound_resource", "tz_offset", "dt_out"
      ]
    },
    "get_visits_duration": {
      "report_id": "slim_p2_12",
      "title": "Visit Duration",
      "family": "summary",
      "kind": "visit_duration"
    },
    "count_records_id": {
      "report_id": "slim_p1_03",
      "title": "At a Glance",
      "family": "count",
      "column": "id",
      "distinct": false,
      "equality": "binary",
      "windowed": false
    },
    "count_records_ip": {
      "report_id": "slim_p1_03",
      "title": "At a Glance",
      "family": "count",
      "column": "ip",
      "distinct": true,
      "equality": "ascii_ci",
      "windowed": false
    },
    "count_records_resource": {
      "report_id": "slim_p1_03",
      "title": "At a Glance",
      "family": "count",
      "column": "resource",
      "distinct": true,
      "equality": "ascii_ci",
      "windowed": false
    },
    "rows_in_window": {
      "report_id": "slim_p1_03",
      "title": "At a Glance",
      "family": "count",
      "column": "id",
      "distinct": false,
      "equality": "binary",
      "windowed": true
    },
    "top_resource": {
      "report_id": "slim_p1_08",
      "title": "Top Web Pages",
      "family": "top",
      "dimension": "resource",
      "grain": ["blog_id"],
      "count_field": "counthits",
      "limit_setting": "limit_results",
      "default_limit": 200
    },
    "top_country": {
      "report_id": "slim_p1_13",
      "title": "Top Countries",
      "family": "top",
      "dimension": "country",
      "grain": ["blog_id"],
      "count_field": "counthits",
      "limit_setting": "limit_results",
      "default_limit": 200
    },
    "top_platform": {
      "report_id": "slim_p2_06",
      "title": "Top Operating Systems",
      "family": "top",
      "dimension": "platform",
      "grain": ["blog_id"],
      "count_field": "counthits",
      "limit_setting": "limit_results",
      "default_limit": 200
    },
    "top_browser": {
      "report_id": "slim_p2_18",
      "title": "Top Browser Families",
      "family": "top",
      "dimension": "browser",
      "grain": ["blog_id"],
      "count_field": "counthits",
      "limit_setting": "limit_results",
      "default_limit": 200
    },
    "top_referer": {
      "report_id": "slim_p1_10",
      "title": "Top Referring Domains",
      "family": "top",
      "dimension": "referer",
      "grain": ["blog_id"],
      "count_field": "counthits",
      "limit_setting": "limit_results",
      "default_limit": 200
    },
    "top_referer_domains": {
      "report_id": "slim_p1_10",
      "title": "Top Referring Domains",
      "family": "top",
      "dimension": "referer",
      "grain": ["blog_id"],
      "count_field": "counthits",
      "limit_setting": "limit_results",
      "default_limit": 200,
      "transform": "referer_domain",
      "exclude_null": true
    },
    "count_human_hits": {
      "report_id": "slim_p2_01",
      "title": "Human Visits",
      "family": "count",
      "column": "id",
      "distinct": false,
      "equality": "binary",
      "windowed": false,
      "where_not_equal": {"column": "browser_type", "value": 1}
    },
    "count_records_visit_id": {
      "report_id": "slim_p2_01",
      "title": "Human Visits",
      "family": "count",
      "column": "visit_id",
      "distinct": true,
      "equality": "binary",
      "windowed": false
    },
    "top_platform_prefixed": {
      "report_id": "slim_p2_19",
      "title": "Top OS Families",
      "family": "top",
      "dimension": "platform",
      "grain": ["blog_id"],
      "count_field": "counthits",
      "limit_setting": "limit_results",
      "default_limit": 200,
      "transform": "platform_prefix"
    },
    "top_resource_trimmed": {
      "report_id": "slim_p4_11",
      "title": "Top Posts",
      "family": "top",
      "dimension": "resource",
      "grain": ["blog_id"],
      "count_field": "counthits",
      "limit_setting": "limit_results",
      "default_limit": 200,
      "transform": "trim_trailing_slash"
    },
    "get_recent_events": {
      "report_id": "slim_p4_10",
      "title": "Recent Custom Events",
      "family": "recent",
      "kind": "recent_events",
      "columns": ["event_id", "type", "event_description", "notes", "position", "id", "dt", "ip", "resource"]
    },
    "get_top_events": {
      "report_id": "slim_p4_12",
      "title": "Top Custom Events",
      "family": "top",
      "kind": "top_events",
      "dimension": "notes",
      "grain": ["blog_id"],
      "count_field": "counthits",
      "limit_setting": "limit_results",
      "default_limit": 200
    },
    "get_top_outbound": {
      "report_id": "slim_p4_21",
      "title": "Top Outbound Links",
      "family": "top",
      "kind": "top_outbound",
      "dimension": "outbound_resource",
      "grain": ["blog_id"],
      "count_field": "counthits",
      "limit_setting": "limit_results",
      "default_limit": 200
    },
    "bouncing_visits_pinned": {
      "report_id": "slim_p4_23",
      "title": "Top Bounce Pages",
      "family": "count",
      "kind": "singletons",
      "group_column": "visit_id",
      "counted_column": "id",
      "where": [["visit_id", "gt", 0], ["browser_type", "ne", 1]],
      "equality": "binary",
      "windowed": true
    },
    "count_bouncing_pages": {
      "report_id": "slim_p4_23",
      "title": "Top Bounce Pages",
      "family": "count",
      "kind": "singletons",
      "group_column": "resource",
      "counted_column": "visit_id",
      "where": [["visit_id", "gt", 0], ["content_type", "ne", "404"]],
      "equality": "ascii_ci",
      "windowed": true
    }
  }
}
