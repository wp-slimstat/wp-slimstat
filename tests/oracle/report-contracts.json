      "family": "count",
      "column": "id",
      "distinct": false,
      "equality": "binary",
      "windowed": false
    },
    "count_records_ip": {
      "report_id": "slim_p1_03",
      "title": "At a Glance",
      "family": "count",
      "column": "ip",
      "distinct": true,
      "equality": "ascii_ci",
      "windowed": false
    },
    "count_records_resource": {
      "report_id": "slim_p1_03",
      "title": "At a Glance",
      "family": "count",
