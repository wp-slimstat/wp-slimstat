# tests/docker/matrix.env — the one file to edit for future runs.
# Edit the version lists, save, then `./run-matrix.sh`.

# PHP versions to test (must have a `php:<ver>-apache` Docker image upstream).
PHPS=(7.4 8.0 8.1 8.2 8.3 8.4)

# WordPress versions to test against each PHP version.
# NOTE: WP 5.6 core does not boot on PHP 8.1+ — those cells are auto-detected
# and recorded BLOCKED-BY-WP-CORE (not a plugin failure).
WPS=(5.6 7.0)

# MySQL image for the cell database.
#
# WHY THIS IS HERE (C49). No database older than 8.0 has ever been exercised, anywhere:
# this harness pinned mysql:8.0 and CI's wp-env lanes ship MariaDB. That matters because
# ADR-2 declares MySQL 5.6 the floor, and 5.6 has CTEs and window functions from neither —
# whereas MariaDB has both from 10.2. So an ADR-2 violation passes CI and fails on the
# declared floor.
#
# Two behavioural differences that will show up as report diffs rather than errors:
#   - 5.6 implicitly sorts by GROUP BY columns; 8.0 does not. Any rendered list without an
#     explicit ORDER BY is in plan order on 8.0 and sorted on 5.6.
#   - ONLY_FULL_GROUP_BY is off by default in 5.6 and on in 8.0.
# The parity oracle will call both a diff. That is expected, and it is the point of the cell.
#
# On Apple Silicon, 5.6/5.7 have no arm64 image — run them with
# DOCKER_DEFAULT_PLATFORM=linux/amd64 (emulated, slower, correct).
MYSQL_IMAGE="${MYSQL_IMAGE:-mysql:8.0}"

# How many cells to run in parallel. The host Playwright run (single-worker by
# design) is the real constraint — 2 is comfortable on 16GB/8-core, 3 on 32GB.
CONCURRENCY=2

# Fail a cell on a wp-slimstat *deprecation* (not just fatal). Off by default
# because some upstream/vendor deprecations on newer PHP are expected.
STRICT_DEPRECATIONS=0

# Run the Playwright E2E step per cell (1) or skip it entirely (0).
RUN_E2E=1

# 1 = run ONLY the gating CORE_SPECS for E2E (fast, ~3-5 min/cell).
# 0 = run the FULL suite; its non-core extras are informational and dominated by
#     bare-container env-failures (GeoIP DB / consent CMP / fixtures), so they add
#     little signal and a lot of wall time. Core-only yields the same verdict.
E2E_CORE_ONLY=1

# Host port bases; each cell gets BASE+index. Change only if these collide.
BASE_HTTP_PORT=18000
BASE_DB_PORT=13000

# E2E specs that GATE a cell's verdict. The full suite still runs (informational),
# but only failures in these gate PASS/FAIL — they're self-contained (no GeoIP DB,
# consent CMP, or seeded fixtures a bare Free+Pro container lacks) and map to the
# high-risk areas. Add/remove here as the suite evolves — no need to touch scripts.
CORE_SPECS=(
  issue-php74-admin-load.spec.ts        # ENV-1: wp-admin loads on the PHP version
  feedbackbird-removed.spec.ts          # privacy: no external FeedbackBird call
  wp56-jquery-migrate-console.spec.ts   # JS: jQuery-4 console clean
  browscap-namespace-fix.spec.ts        # tracker: Browscap path, no 500
  analytics-correctness-invariants.spec.ts  # data integrity
  upgrade-safety.spec.ts                # upgrade: schema/data intact
  referer-android-app.spec.ts           # tracking: android-app referer + scheme reject
  reports-fingerprint-xss.spec.ts       # security: stored-XSS escaping
)
