+        //
+        // Narrow ON PURPOSE. `resource` with no WHERE is the call `top_resource` makes and the
+        // only captured report that makes it: top_resource_human and top_resource_in_window
+        // carry a WHERE, and top_resource_trimmed arrives here as the string
+        // 'TRIM(TRAILING "/" FROM resource) AS resource'. So exactly one report loses exactly
+        // one row, which is a harder thing to see than the six a patch at the shared LIMIT
+        // site would have moved.
+        if ('resource' === $_column && '' === $_where) {
+            $limit = max(1, $limit - 1);
+        }
