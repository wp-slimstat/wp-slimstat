target:    tests/e2e/css-reduced-motion.spec.ts
gate:      php tests/e2e-quarantine-census-test.php
kind:      restore-defect
expect:    `pro` skip site(s); tests/E2E-QUARANTINE-CEILING says 1
rationale: The reason the ceiling is three numbers instead of one. This rewrites a bare `test.skip()` in a spec that has nothing to do with Pro into a Pro-shaped guard: a single total would not move at all, and the census would stay green while a permanently disabled test walked into the deliberate carve-out. Under per-class counts the same edit raises `pro` and lowers `unconditional`, so it fails twice and names both halves.
---
--- a/tests/e2e/css-reduced-motion.spec.ts
+++ b/tests/e2e/css-reduced-motion.spec.ts
@@ -87,7 +87,7 @@
     // Inspect the CSS source files for correct scoping
     const cssDir = path.join(PLUGIN_DIR, 'admin', 'assets', 'css');
     if (!fs.existsSync(cssDir)) {
-      test.skip();
+      test.skip(!proActive, 'Pro is not active');
       return;
     }
 
