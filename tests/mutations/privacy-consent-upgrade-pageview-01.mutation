target:    src/Tracker/Processor.php
gate:      php tests/anonymous-identity-test.php
kind:      restore-defect
expect:    consent upgrade must target only the signed pageview
rationale: Restores session-based enrichment of earlier anonymous history instead of the signed current pageview.
---
diff --git a/src/Tracker/Processor.php b/src/Tracker/Processor.php
--- a/src/Tracker/Processor.php
+++ b/src/Tracker/Processor.php
@@ -500,7 +500,7 @@
 
                     // Never associate a previous anonymous visit by IP or session alone.
                     $query = Query::select('id, ip, visit_id, fingerprint, username, email, notes')
-                        ->from($table)->where('id', '=', $requestId > 0 ? $requestId : 0);
+                        ->from($table)->where('visit_id', '=', $stat['visit_id']);
 
                     $existing_record = $query->orderBy('dt', 'DESC')
                         ->limit(1)
