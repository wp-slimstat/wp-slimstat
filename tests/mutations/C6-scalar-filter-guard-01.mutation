kind: guard-removal
expect: unsafe or explicitly uncached shape must not split: raw
rationale: Late metadata updates can change membership in a filtered historical count.
---
--- a/src/Utils/Query.php
+++ b/src/Utils/Query.php
@@ -1442,7 +1442,7 @@
         $canSplit = $this->allowHistoricalCaching && !$this->_isLiveQuery
