target:    wp-slimstat.php
gate:      php tests/subsite-table-hook-test.php
kind:      name-only
expect:    does not register a callback on 'wp_initialize_site'
rationale: Removes the registration and LEAVES THE COMMENT BLOCK naming wp_initialize_site right above where it stood. A text scan for the hook name passes on the comment alone; the gate must demand the add_action construct with the hook name as its first string-literal argument.
---
diff --git a/wp-slimstat.php b/wp-slimstat.php
--- a/wp-slimstat.php
+++ b/wp-slimstat.php
@@ -2594,7 +2594,6 @@
     // is_admin() is false and the admin bundle — home of the old wpmu_new_blog
     // registration — was never loaded. The callback itself checks network-active status
     // at fire time, so on single sites and per-site-activated networks this is a no-op.
-    add_action('wp_initialize_site', ['wp_slimstat', 'on_initialize_site'], 200);

     add_action('widgets_init', ['wp_slimstat', 'register_widget']);
