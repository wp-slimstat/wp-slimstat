target:    tests/e2e/user-exclusion-server-mode.spec.ts
gate:      php tests/e2e-credential-source-test.php
kind:      restore-defect
expect:    spells the credential 'parhumm'
rationale: Puts one developer's account name back into a SETTING rather than into a login form. On a lane whose admin is `admin`, ignore_users names nobody, the exclusion never happens and the spec fails on its own subject while the harness is what is wrong -- which is how this shape read as a product defect for the whole programme. The login in the same file still uses the constant, so only the literal scan can fire.
---
--- a/tests/e2e/user-exclusion-server-mode.spec.ts
+++ b/tests/e2e/user-exclusion-server-mode.spec.ts
@@ -144,7 +144,7 @@
   // ────────────────────────────────────────────────────────────────
   test('ignore_users excludes specific username in server-side mode', async ({ browser }) => {
     await setSlimstatSetting('ignore_wp_users', 'no');
-    await setSlimstatSetting('ignore_users', ADMIN_USER);
+    await setSlimstatSetting('ignore_users', 'parhumm');
 
     const { context, page } = await loginAsAdmin(browser);
     await clearStatsTable();
