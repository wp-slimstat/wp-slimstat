target:    admin/index.php
gate:      php tests/textdomain-single-source-test.php
kind:      restore-defect
expect:    that domain is not loaded by this plugin
rationale: Bind a free string to Pro's text domain again. Free ships no wp-slimstat-pro .mo file and, on a site without Pro installed, nothing loads that domain at all - so the string falls back to English in every locale, permanently and with no error of any kind: __() with an unloaded domain simply returns its input. wp.org's Plugin Check reports it as WordPress.WP.I18n.TextDomainMismatch, which has blocked a release of this plugin before.
---
--- a/admin/index.php
+++ b/admin/index.php
@@ -4327,7 +4327,7 @@
 
         return '<a class="button-export-to-xls slimstat-font-download noslimstat" href="' . esc_url($url) . '"'
             . ($admin ? '' : ' target="_blank" rel="noopener"') . $attributes
-            . ' title="' . esc_attr__('Export to CSV with Pro', 'wp-slimstat') . '"><span class="dashicons dashicons-download" aria-hidden="true"></span>'
+            . ' title="' . esc_attr__('Export to CSV with Pro', 'wp-slimstat-pro') . '"><span class="dashicons dashicons-download" aria-hidden="true"></span>'
             . esc_html__('Export', 'wp-slimstat') . '</a>';
     }
 
