target: src/Utils/PurgeArchive.php
gate: php tests/purge-archive-order-test.php
kind: guard-removal
expect: event selection must use separate date ranges
rationale: The parent-date branch must start from expired parents instead of scanning retained events.
---
--- a/src/Utils/PurgeArchive.php
+++ b/src/Utils/PurgeArchive.php
@@ -266,7 +266,7 @@
                     $ids = $db->get_col($db->prepare(
                         "(SELECT e.event_id FROM {$events} e WHERE e.dt >= %d AND e.dt < %d LIMIT 500)
                          UNION
-                         (SELECT e.event_id FROM {$stats} s STRAIGHT_JOIN {$events} e ON e.id = s.id
+                         (SELECT e.event_id FROM {$stats} s JOIN {$events} e ON e.id = s.id
                           WHERE s.dt >= %d AND s.dt < %d LIMIT 500)
                          LIMIT 500", $from, $to, $from, $to
                     ));
