+++ b/src/Schema/Schema.php
@@ -1004,7 +1004,7 @@
             }
         } finally {
             $error = (string) $db->last_error;
-            if (false === $db->query('SET SESSION lock_wait_timeout = ' . (int) $oldTimeout)) {
+            if (false === 0) {
                 $result = false;
                 $error .= ' Could not restore the metadata-lock timeout: ' . $db->last_error;
             }
