target: admin/index.php
gate: php tests/chart-request-boundary-test.php
kind: guard-removal
expect: Spaced username must remain one exact account
rationale: An internal space belongs to the username, not a second account.
---
--- a/admin/index.php
+++ b/admin/index.php
@@ -670,7 +670,7 @@
             $user_id = 1;
         } else {
             $user = wp_get_current_user();
-            $whitelist = array_map('trim', preg_split('/[\r\n,]+/', (string) (wp_slimstat::$settings['can_customize'] ?? ''), -1, PREG_SPLIT_NO_EMPTY));
+            $whitelist = array_map('trim', preg_split('/[\s,]+/', (string) (wp_slimstat::$settings['can_customize'] ?? ''), -1, PREG_SPLIT_NO_EMPTY));
             $capability = wp_slimstat::$settings['capability_can_customize'] ?? 'manage_options';
             if (!$user->ID || !(current_user_can('manage_options') || current_user_can($capability ?: 'read')
                 || (current_user_can('read') && in_array($user->user_login, $whitelist, true)))) {
