#composer.lock
composer.lock

# Composer vendor packages — dev deps (PHPUnit, Mockery) use PHP 8.1+
# syntax that causes parse errors in wp-env PHP 7.4 containers.
# The autoloader (vendor/autoload.php + vendor/composer/) MUST stay
# tracked because wp-slimstat.php requires it at line 18.
/vendor/*
!/vendor/autoload.php
!/vendor/composer/
# Exclude composer metadata generated by `composer install` — only the
# autoloader mapping files (autoload_*.php, ClassLoader.php, LICENSE) are needed.
/vendor/composer/installed.json
/vendor/composer/installed.php
/vendor/composer/InstalledVersions.php
/vendor/composer/autoload_files.php

# Testing
.env.testing
test-results/
tests/e2e/.auth/
tests/e2e/playwright-report/
tests/e2e/run-artifacts/
# wp-env per-lane override emitted by CI (and local matrix runs); the committed
# .wp-env.json stays the 6.4 baseline.
.wp-env.override.json
# Bun
bun.lock

# Package
package-lock.json

# PHP CS Fixer configuration file
.php-cs-fixer.dist.php

# PHPUnit
.phpunit.result.cache

# PHPStan local override (the committed config is phpstan.neon.dist)
phpstan.neon

# Mutation and equivalence run output. The tracked ratchets are tests/mutations/FLOOR and
# FLOOR-NAME-ONLY; a results file committed from a local run is a claim its author wrote,
# not one a runner produced under controlled conditions. CI uploads the real ones.
tests/verify/results/*.json
